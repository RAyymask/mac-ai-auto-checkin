<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.ai-daily-checkin</string>
    <!-- 安装后可在本文件加 <key>EnvironmentVariables</key> 做本机定制，
         例如会话受限时 <key>DOUBAO_DISABLE</key><string>1</string> 停用豆包。
         install.sh 会在重装时保留它；改完需 bootout + bootstrap 重新加载。 -->
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON_BIN}}</string>
        <string>{{TARGET_DIR}}/run_all.py</string>
    </array>
    <!-- 本服务不设 RunAtLoad：install.sh 会同步试跑一次，叠加会重复发请求。
         关机期间错过的排程由独立的 com.user.ai-daily-checkin.catchup
         （RunAtLoad）在登录后补跑；本服务只负责 10:05 / 15:05 / 20:05。 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>10</integer>
            <key>Minute</key>
            <integer>5</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>15</integer>
            <key>Minute</key>
            <integer>5</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>5</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>{{TARGET_DIR}}/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{TARGET_DIR}}/launchd.err.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
